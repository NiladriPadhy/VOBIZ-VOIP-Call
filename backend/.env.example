PORT=3000
PUBLIC_URL=https://replace-with-your-tunnel.example

# Use random values of at least 32 characters.
DEVICE_TOKEN=replace-with-a-random-device-token
WEBHOOK_TOKEN=replace-with-a-separate-random-webhook-token

# Devices register their own SIP username and caller ID with the backend.
DEFAULT_COUNTRY_CODE=91
MAX_CALL_SECONDS=300

# Required for terminated-app decline/hangup. Never put these in the APK.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_API_BASE_URL=https://api.vobiz.ai

# Download from Firebase Admin SDK and keep outside source control.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Optional. URL returning wait-audio XML played to an inbound caller while they
# are parked in the conference before the app answers. Leave unset for silence.
# CONFERENCE_WAIT_SOUND=https://your-tunnel.example/hold-music
